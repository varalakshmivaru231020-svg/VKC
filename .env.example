# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/vijaylakshmi"

# ── Next.js ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# ── Cloudinary (Image Storage) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# ── Razorpay (Payments) ───────────────────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ── Resend (Email) ────────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Vijaylakshmi Sarees <hello@vijaylakshmi.in>"

# ── SMS / OTP (MSG91 v5) ──────────────────────────────────────────────────────
# Endpoint used: POST https://control.msg91.com/api/v5/otp
# Sender ID and template_id must be approved on MSG91 DLT dashboard.
MSG91_AUTH_KEY=""
MSG91_SENDER_ID="VIJLAK"
MSG91_TEMPLATE_ID=""

# Mobile app OTP (/api/v1/auth/otp/send).
# Unset or "true" uses the fixed code 1234 and sends NO SMS — a local
# development convenience. It is IGNORED when NODE_ENV=production, which always
# issues a random code and sends it via MSG91. Set "false" locally to test real
# SMS delivery.
MOBILE_USE_FIXED_OTP="false"

# ── ICICI PG Direct (Phicommerce v2) ─────────────────────────────────────────
# Normally configured in Admin → Settings → Payments (DB settings win over these).
# The three URLs below are optional: left blank they follow ICICI_PG_TEST_MODE —
#   test → https://pgpayuat.icicibank.com/tsp/pg/api/{v2,command,settlementDetails}
#   live → https://pgpay.icicibank.com/pg/api/{v2,command,settlementDetails}
ICICI_PG_ENABLED=0
ICICI_PG_TEST_MODE=1
ICICI_PG_BASE_URL=""
ICICI_PG_COMMAND_URL=""
ICICI_PG_SETTLEMENT_DETAILS_URL=""
ICICI_PG_MERCHANT_ID=""
ICICI_PG_AGGREGATOR_ID=""
ICICI_PG_KEY=""
# Blank → derived as ${NEXT_PUBLIC_BASE_URL}/api/web/checkout/icici-pg/return
ICICI_PG_RETURN_URL=""
ICICI_PG_ALLOWED_MODES=""

# ── Shiprocket ───────────────────────────────────────────────────────────────
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_PICKUP_PINCODE=""
SHIPROCKET_POLL_MINUTES="30"

# ── DTDC (direct courier) — prefer Admin → Settings → SMS/Shipping (dtdc_* keys).
