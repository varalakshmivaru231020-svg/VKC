DTDC_BASE_URL="https://dtdcapi.shipsy.io"
DTDC_API_KEY=""
DTDC_CUSTOMER_CODE=""
DTDC_DEFAULT_SERVICE_TYPE="B2C SMART EXPRESS"
DTDC_TRACKING_BASE_URL="https://blktracksvc.dtdc.com"
DTDC_TRACKING_TOKEN=""
DTDC_ORIGIN_NAME=""
DTDC_ORIGIN_PHONE=""
DTDC_ORIGIN_ADDRESS_1=""
DTDC_ORIGIN_ADDRESS_2=""
DTDC_ORIGIN_PINCODE=""
DTDC_ORIGIN_CITY=""
DTDC_ORIGIN_STATE=""

# ── Delhivery (direct courier) — prefer Admin → Settings (delhivery_* keys).
DELHIVERY_BASE_URL="https://track.delhivery.com"
DELHIVERY_API_TOKEN=""
DELHIVERY_PICKUP_NAME=""
