<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch window: brand ivory with the VKC emblem centred. Shown only
     while the Flutter engine starts; the app then opens straight on Home. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/brand_canvas" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
