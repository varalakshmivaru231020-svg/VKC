<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production traffic must be HTTPS. -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- Permit cleartext HTTP only to the local dev backend -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>      <!-- Android emulator -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">192.168.1.8</domain>   <!-- LAN dev IP -->
    </domain-config>
</network-security-config>
